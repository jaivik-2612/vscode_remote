// Allow amnesia to start tails-possibly-hide-thunderbird-launcher.service;
// fall back to implicit authorization otherwise.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "tails-possibly-hide-thunderbird-launcher.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "amnesia") {
        return polkit.Result.YES;
    }
});

// Allow amnesia to restart tails-possibly-hide-thunderbird-launcher.service;
// fall back to implicit authorization otherwise.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "tails-possibly-hide-thunderbird-launcher.service" &&
        action.lookup("verb") == "restart" &&
        subject.user == "amnesia") {
        return polkit.Result.YES;
    }
});
