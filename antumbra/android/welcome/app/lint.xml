<?xml version="1.0" encoding="UTF-8"?>
<!-- Lint settings for the Welcome app. Each change to a default is explained. -->
<lint>
    <!-- Versions are pinned on purpose (gradle/libs.versions.toml) and
         updated by hand together with their checksums; these checks only
         report that something newer exists, which needs the network. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- targetSdk 36 (Android 16) is the project's choice: LineageOS 23.2
         on the phone and the CI emulator both run API 36. -->
    <issue id="OldTargetApi" severity="ignore" />
</lint>
