<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     The window theme under Compose: the Material 3 dark surface from the
     start, so no light frame shows before the first composition. The colours
     come from ui/Theme.kt (Material 3 tonal-spot dark scheme, seed #4d2c9e). -->
<resources>
    <style name="Theme.Antumbra" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
