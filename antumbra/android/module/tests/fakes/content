#!/system/bin/sh
# Test stand-in for Android's content command, answering only
#   content query --user 0 --uri content://org.antumbra.welcome.state/session --projection A:B:...
# like Welcome's StateProvider: one row with the asked columns in the
# asked order. Values are NAME=VALUE lines in /antumbra-test/welcome;
# bridges come from /antumbra-test/welcome.bridges (one per line). And
#   content query --uri content://telephony/siminfo --projection _id
# with one row per subscription ID in /antumbra-test/siminfo. And
#   content call --user 0 --uri content://org.antumbra.welcome.state --method module_word --extra K:T:V...
# like Welcome's StateProvider.call from root (MOD11): the extras are
# appended as one line to /antumbra-test/welcome.words, and it prints
# "Result: Bundle[{v=1}]"; with /antumbra-test/welcome-refuses it prints a
# refusal on standard error and exits 0, as the real tool does, and
# appends one line (no extras) to /antumbra-test/welcome.refused. And
#   content call ... --method module_cell --extra K:T:V...
# (WEL8) likewise, into /antumbra-test/welcome.cells. With
# /antumbra-test/welcome-old it plays a Welcome from before WEL8: a
# projection naming "cell" gets the provider's "Unknown column: cell" on
# standard error and nothing on standard output (exit 0), and module_cell
# "Unknown method" (one line appended to /antumbra-test/welcome.cells-refused,
# with the module's clock, /proc/uptime, in whole seconds).
T=/antumbra-test
[ -f $T/framework-up ] || { echo "Error while accessing provider" >&2; exit 1; }
what=${1-}
proj='' uri='' method='' extras=''
while [ $# -gt 0 ]; do
	case $1 in
	--projection) proj=$2; shift 2 ;;
	--uri) uri=$2; shift 2 ;;
	--method) method=$2; shift 2 ;;
	--extra) extras="$extras${extras:+ }$2"; shift 2 ;;
	*) shift ;;
	esac
done
if [ "$what" = call ]; then
	if [ "$uri" = content://org.antumbra.welcome.state ] && [ "$method" = module_cell ]; then
		if [ -e $T/welcome-old ]; then
			echo "refused $(cut -d. -f1 /proc/uptime)" >>$T/welcome.cells-refused
			echo "Error while accessing provider:org.antumbra.welcome.state" >&2
			echo "java.lang.IllegalArgumentException: Unknown method: module_cell" >&2
			exit 0
		fi
		echo "$extras" >>$T/welcome.cells
		echo 'Result: Bundle[{v=1}]'
		exit 0
	fi
	if [ "$uri" != content://org.antumbra.welcome.state ] || [ "$method" != module_word ]; then
		echo "Error while accessing provider:${uri#content://}" >&2
		exit 0
	fi
	if [ -e $T/welcome-refuses ]; then
		echo refused >>$T/welcome.refused
		echo "Error while accessing provider:org.antumbra.welcome.state" >&2
		echo "java.lang.SecurityException: uid 0 may not call module_word" >&2
		exit 0
	fi
	echo "$extras" >>$T/welcome.words
	echo 'Result: Bundle[{v=1}]'
	exit 0
fi
case $uri in
content://telephony/siminfo)
	[ "$proj" = _id ] || exit 1
	n=0
	if [ -s $T/siminfo ]; then
		while read -r id; do
			echo "Row: $n _id=$id"
			n=$((n + 1))
		done <$T/siminfo
	else
		echo "No result found."
	fi
	exit 0
	;;
content://org.antumbra.welcome.state/session) ;;
*) exit 1 ;;
esac
[ -f $T/welcome ] || { echo "Error while accessing provider:org.antumbra.welcome.state" >&2; exit 1; }
if [ -e $T/welcome-old ]; then
	case :$proj: in *:cell:*)
		echo "Error while accessing provider:org.antumbra.welcome.state" >&2
		echo "java.lang.IllegalArgumentException: Unknown column: cell" >&2
		echo "	at org.antumbra.welcome.StateRow.columns(StateProvider.kt:96)" >&2
		exit 0
		;;
	esac
fi
out='Row: 0 '
sep=
old=$IFS
IFS=:
for col in $proj; do
	IFS=$old
	if [ "$col" = bridges ]; then
		v=$(cat $T/welcome.bridges 2>/dev/null)
	else
		v=$(grep -F "$col=" $T/welcome | sed -n "s/^$col=//p" | tail -n 1)
	fi
	out="$out$sep$col=$v"
	sep=', '
done
IFS=$old
printf '%s\n' "$out"
