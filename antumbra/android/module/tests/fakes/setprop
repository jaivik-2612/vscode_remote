#!/system/bin/sh
# Test stand-in for Android's setprop (and, through resetprop, Magisk's).
# An empty value removes the property, as far as getprop can tell.
f=/antumbra-test/props
[ $# -eq 2 ] || { echo "usage: setprop NAME VALUE" >&2; exit 1; }
i=0
while ! mkdir /antumbra-test/props.lock 2>/dev/null; do
	i=$((i + 1))
	[ "$i" -gt 100 ] && { echo "setprop: lock" >&2; exit 1; }
	sleep 0.1
done
{
	grep -v -F "$1=" "$f"
	[ -n "$2" ] && printf '%s=%s\n' "$1" "$2"
} >"$f.new"
mv -f "$f.new" "$f"
rmdir /antumbra-test/props.lock
