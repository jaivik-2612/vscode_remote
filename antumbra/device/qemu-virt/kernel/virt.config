# Antumbra kernel fragment for the QEMU "virt" machine, merged after the
# phone's antumbra.config (which stays untouched). The hotdog configuration
# already builds in PCI host-generic, virtio core/PCI/MMIO, virtio-blk,
# virtio-net, virtio-console, virtio-rng and the PL011 serial console; this
# adds what a graphical session and the harness need.
#
# Display and input (Phosh needs a DRM device; the harness drives a virtio
# keyboard and tablet).
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
# The virt machine's RTC and its GPIO-driven power button (QEMU
# system_powerdown exercises the shutdown path).
CONFIG_RTC_DRV_PL031=y
CONFIG_GPIO_PL061=y
# Sound for the session, as a module like the phone's ALSA stack.
CONFIG_SND_VIRTIO=m
# The network driver must be a module: the phone's Wi-Fi driver is one, and
# the whole design (driver blocklist until the Welcome screen, MAC spoofing
# on interface appearance) relies on it. Built in, the interface would exist
# before the Welcome decision and the VM would not exercise that path.
CONFIG_VIRTIO_NET=m
