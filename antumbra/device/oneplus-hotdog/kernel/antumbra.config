# Antumbra kernel configuration fragment for the OnePlus 7T Pro (hotdog).
#
# Merged over the port's config-oneplus-hotdog-mainline617-clean.aarch64
# with scripts/kconfig/merge_config.sh. build/kernel.sh fails if any line
# below is not honoured in the final .config. Rationale: docs/architecture.md
# section 13.

# --- Netfilter pieces the Tor-enforcement ruleset needs -------------------
CONFIG_NFT_REDIR=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m

# --- Root filesystem: multi-core squashfs decompression, dm-verity ---------
CONFIG_SQUASHFS_FILE_DIRECT=y
# CONFIG_SQUASHFS_FILE_CACHE is not set
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
# CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE is not set
CONFIG_SQUASHFS_ZSTD=y
CONFIG_DM_VERITY=y

# --- Security modules: AppArmor for Tails' confinement, Yama for ptrace_scope
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"
CONFIG_SECURITY_DMESG_RESTRICT=y

# --- Memory hardening (the command line enables the same at run time) ------
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_ARM64_BTI_KERNEL=y

# --- Nothing survives a reboot in DRAM: no pstore/ramoops ------------------
# (ACPI APEI selects pstore; this phone has no ACPI tables, so APEI goes too)
# CONFIG_ACPI_APEI is not set
# CONFIG_PSTORE is not set

# --- QRTR: no tunnel device; userspace access is capability-gated by patch 0101
# CONFIG_QRTR_TUN is not set

# --- No cellular data path in version 1 -------------------------------------
# CONFIG_QCOM_IPA is not set
# CONFIG_RMNET is not set

# --- Attack surface -----------------------------------------------------------
# CONFIG_IKCONFIG_PROC is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_DEVPORT is not set
# CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE is not set
CONFIG_CRYPTO_USER_API_AEAD=m

# --- The phone's own firmware (antumbra-phone-firmware): the GPU's zap shader
# is on the vendor partition, which OxygenOS formats as EROFS. A module that
# only that service loads (modprobe.d/erofs.conf keeps mount from loading it
# for any other medium).
CONFIG_EROFS_FS=m

# --- RTC alarm wake-up for the auto-shutdown timer ---------------------------
CONFIG_RTC_DRV_PM8XXX=y

# --- Protection-domain mapper: the in-kernel implementation (no userspace
# daemon, no vendor map files). It cannot be built in because QRTR is a
# module; the overlay loads it through modules-load.d.
CONFIG_QCOM_PD_MAPPER=m

# --- Android apps (Waydroid, opt-in): static root-only binder nodes, no binderfs
# These pin what the port's configuration already sets. binderfs stays off:
# it can be mounted from an unprivileged user namespace, so it would give
# any local user binder devices even while Android is off; the three static
# nodes are root-only (0600) until Waydroid opens them when Android starts.
# PSI feeds Android's low-memory killer; COMPAT runs the 32-bit half of the
# arm64 images.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_COMPAT=y
