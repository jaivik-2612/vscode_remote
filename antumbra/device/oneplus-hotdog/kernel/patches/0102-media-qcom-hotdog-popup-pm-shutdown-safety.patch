 #define HOTDOG_PREFLIGHT_MICROSTEPS	320
 #define HOTDOG_CLOSED_DOWN_MIN		300
@@ -45,6 +52,35 @@
 #define HOTDOG_RAMP_MICROSTEPS		(30 * 32)
 #define HOTDOG_PROGRESS_PROBE_MICROSTEPS	(100 * 32)
 #define HOTDOG_HALL_POLL_US		15000
+/*
+ * Stock OxygenOS step periods (oneplus_motor.c SPEED10 for the ramp, SPEED0
+ * after it). The motor must never step faster than these, whatever period
+ * the PWM controller rounds a request to.
+ */
+#define HOTDOG_STOCK_SLOW_PERIOD_NS	104166
+#define HOTDOG_STOCK_FAST_PERIOD_NS	12000
+/*
+ * Wall-clock cap for one Hall-terminated course: the nominal 44160-microstep
+ * course at the periods above (960 x 105000 ns + 43200 x 13125 ns, about
+ * 668 ms) plus 50 ms, the time one slow Hall read can stretch the slow ramp.
+ * Stock stops its course on a timer of about 620 ms at 12000 ns.
+ */
+#define HOTDOG_COURSE_NOMINAL_NS					\
+	((u64)HOTDOG_RAMP_MICROSTEPS * HOTDOG_SLOW_PERIOD_NS +		\
+	 (u64)(HOTDOG_FULL_COURSE_MICROSTEPS - HOTDOG_RAMP_MICROSTEPS) *	\
+	 HOTDOG_FAST_PERIOD_NS)
+#define HOTDOG_COURSE_CAP_NS		(HOTDOG_COURSE_NOMINAL_NS + \
+					 50 * NSEC_PER_MSEC)
+/* How far past its planned end the watchdog lets a fixed-length run go. */
+#define HOTDOG_EXACT_SLACK_NS		(5 * NSEC_PER_MSEC)
+
+static_assert(HOTDOG_SLOW_PERIOD_NS >= HOTDOG_STOCK_SLOW_PERIOD_NS);
+static_assert(HOTDOG_FAST_PERIOD_NS >= HOTDOG_STOCK_FAST_PERIOD_NS);
+
+static bool debug_knobs;
+module_param(debug_knobs, bool, 0400);
+MODULE_PARM_DESC(debug_knobs,
+		 "Expose the write-once bring-up motion attributes (default: off)");
 
 struct hotdog_popup {
 	struct device *dev;
@@ -75,6 +111,43 @@ struct hotdog_popup {
 	int last_error;
 	unsigned int automatic_open_count;
 	unsigned int automatic_close_count;
+	unsigned int last_elapsed_us;
+	/* Timing of the current STEP run, the base of the microstep budget. */
+	ktime_t run_start;
+	ktime_t fast_start;
+	bool run_fast;
+	u64 slow_period_ns;
+	u64 fast_period_ns;
+	unsigned int slow_steps;
+	/*
+	 * Hard deadline for the current STEP run. The stepping thread checks
+	 * the budget only between Hall reads, and a read can block on I2C
+	 * while STEP keeps pulsing; the watchdog stops the motor on time
+	 * whatever that thread is doing.
+	 */
+	struct hrtimer watchdog;
+	struct work_struct watchdog_work;
+	ktime_t watchdog_deadline;
+	bool watchdog_fired;
+	/*
+	 * System sleep and shutdown, all under lock. domain_on mirrors genpd's
+	 * view while the callbacks only record state; it stays true after a
+	 * failed power_off. consumer_on tells whether a consumer holds the
+	 * camera: set by a successful power_on (while sleeping, from the
+	 * consumers' runtime state), cleared by every power_off.
+	 * reopen_pending asks the post-resume reconcile to raise the camera
+	 * for a stream held across sleep; retract_pending asks it to retry a
+	 * retract that failed before sleep when no consumer wants the camera.
+	 */
+	struct notifier_block pm_nb;
+	struct notifier_block reboot_nb;
+	struct work_struct reconcile_work;
+	bool domain_on;
+	bool consumer_on;
+	bool reopen_pending;
+	bool retract_pending;
+	bool sleeping;
+	bool shutdown;
 };
 
 static bool hotdog_popup_is_closed(int up, int down)
@@ -106,7 +179,13 @@ static void hotdog_popup_pwm_disable(struct hotdog_popup *popup)
 		gpiod_set_value_cansleep(popup->step, 0);
 }
 
-static int hotdog_popup_pwm_enable(struct hotdog_popup *popup, u64 period)
+/*
+ * Start STEP at @period. @stock_period is the stock period for this phase;
+ * @actual returns the period the controller really runs, which the
+ * microstep budget is computed from.
+ */
+static int hotdog_popup_pwm_enable(struct hotdog_popup *popup, u64 period,
+				   u64 stock_period, u64 *actual)
 {
 	struct pwm_state state;
 	int ret;
@@ -130,6 +209,21 @@ static int hotdog_popup_pwm_enable(struct hotdog_popup *popup, u64 period)
 	if (ret)
 		goto err_disable;
 
+	/*
+	 * The PWM core lets a controller round a period down. Read back what
+	 * the hardware runs and stop at once if that is faster than stock.
+	 */
+	*actual = period;
+	if (!pwm_get_state_hw(popup->step_pwm, &state) && state.period)
+		*actual = state.period;
+	if (*actual < stock_period) {
+		dev_err(popup->dev,
+			"STEP period %llu ns is faster than stock %llu ns\n",
+			*actual, stock_period);
+		ret = -ERANGE;
+		goto err_disable;
+	}
+
 	return 0;
 
 err_disable:
@@ -137,6 +231,59 @@ static int hotdog_popup_pwm_enable(struct hotdog_popup *popup, u64 period)
 	return ret;
 }
 
+static enum hrtimer_restart hotdog_popup_watchdog_fn(struct hrtimer *timer)
+{
+	struct hotdog_popup *popup =
+		container_of(timer, struct hotdog_popup, watchdog);
+
+	WRITE_ONCE(popup->watchdog_fired, true);
+	queue_work(system_highpri_wq, &popup->watchdog_work);
+
+	return HRTIMER_NORESTART;
+}
+
+static void hotdog_popup_watchdog_work(struct work_struct *work)
+{
+	struct hotdog_popup *popup =
+		container_of(work, struct hotdog_popup, watchdog_work);
+	struct pwm_state state = { };
+	struct pwm_args args;
+
+	/*
+	 * This runs without popup->lock, which the stepping thread holds while
+	 * it may be blocked in a Hall read. nSLEEP low disables the DRV8834
+	 * bridges whatever STEP does, so it alone ends the motion; nothing sets
+	 * nSLEEP high again before the next run. The stepping thread restores
+	 * the complete safe pin state once it gets control back.
+	 */
+	gpiod_set_value_cansleep(popup->sleep, 0);
+	/* Built from the DT arguments: the stepping thread may be applying. */
+	pwm_get_args(popup->step_pwm, &args);
+	state.period = args.period;
+	state.polarity = args.polarity;
+	pwm_apply_might_sleep(popup->step_pwm, &state);
+	dev_warn(popup->dev, "course deadline reached, watchdog stopped the motor\n");
+}
+
+/* Arm, or move earlier, the hard deadline of the current STEP run. */
+static void hotdog_popup_watchdog_arm(struct hotdog_popup *popup,
+				      ktime_t deadline)
+{
+	/* Once fired, the run is over; keep the deadline it stopped at. */
+	if (READ_ONCE(popup->watchdog_fired))
+		return;
+
+	popup->watchdog_deadline = deadline;
+	hrtimer_start(&popup->watchdog, deadline, HRTIMER_MODE_ABS);
+}
+
+/* watchdog_fired keeps telling whether it had to stop this run. */
+static void hotdog_popup_watchdog_disarm(struct hotdog_popup *popup)
+{
+	hrtimer_cancel(&popup->watchdog);
+	cancel_work_sync(&popup->watchdog_work);
+}
+
 static bool hotdog_popup_halls_plausible(int up, int down)
 {
 	/* Both endpoint sensors are naturally weak around mid-travel. */
@@ -182,18 +329,28 @@ static int hotdog_popup_drive_exact(struct hotdog_popup *popup, bool upward,
 				    unsigned int microsteps)
 {
 	u64 duration_us;
+	u64 period;
 	int ret;
 
+	WRITE_ONCE(popup->watchdog_fired, false);
 	hotdog_popup_power_on(popup, upward);
-	ret = hotdog_popup_pwm_enable(popup, HOTDOG_SLOW_PERIOD_NS);
+	/* A controller only rounds down, so this bounds the planned run. */
+	hotdog_popup_watchdog_arm(popup,
+				  ktime_add_ns(ktime_get(),
+					       (u64)microsteps *
+					       HOTDOG_SLOW_PERIOD_NS +
+					       HOTDOG_EXACT_SLACK_NS));
+	ret = hotdog_popup_pwm_enable(popup, HOTDOG_SLOW_PERIOD_NS,
+				      HOTDOG_STOCK_SLOW_PERIOD_NS, &period);
 	if (ret)
 		goto out;
 
-	duration_us = DIV_ROUND_UP_ULL((u64)microsteps *
-					HOTDOG_SLOW_PERIOD_NS, NSEC_PER_USEC);
+	duration_us = DIV_ROUND_UP_ULL((u64)microsteps * period,
+				       NSEC_PER_USEC);
 	usleep_range(duration_us, duration_us + 100);
 
 out:
+	hotdog_popup_watchdog_disarm(popup);
 	hotdog_popup_stop(popup);
 	return ret;
 }
@@ -282,12 +439,73 @@ static bool hotdog_popup_motion_endpoint(bool upward, int up, int down)
 			 hotdog_popup_is_closed(up, down);
 }
 
+/* Microsteps emitted between the start of the run and @now. */
+static unsigned int hotdog_popup_run_steps(const struct hotdog_popup *popup,
+					   ktime_t now)
+{
+	u64 elapsed_ns;
+	u64 steps;
+
+	if (popup->run_fast && ktime_after(now, popup->fast_start)) {
+		elapsed_ns = ktime_to_ns(ktime_sub(now, popup->fast_start));
+		steps = popup->slow_steps +
+			DIV_ROUND_UP_ULL(elapsed_ns, popup->fast_period_ns);
+	} else if (ktime_after(now, popup->run_start)) {
+		/* Also a run the watchdog ended before the fast switch. */
+		elapsed_ns = ktime_to_ns(ktime_sub(now, popup->run_start));
+		steps = DIV_ROUND_UP_ULL(elapsed_ns, popup->slow_period_ns);
+	} else {
+		steps = 0;
+	}
+
+	return min_t(u64, steps, UINT_MAX);
+}
+
+/* When the current run reaches the microstep budget or the wall-clock cap. */
+static ktime_t hotdog_popup_run_deadline(const struct hotdog_popup *popup)
+{
+	ktime_t cap = ktime_add_ns(popup->run_start, HOTDOG_COURSE_CAP_NS);
+	ktime_t budget;
+
+	if (!popup->run_fast)
+		budget = ktime_add_ns(popup->run_start,
+				      (u64)HOTDOG_FULL_COURSE_MICROSTEPS *
+				      popup->slow_period_ns);
+	else if (popup->slow_steps >= HOTDOG_FULL_COURSE_MICROSTEPS)
+		budget = popup->fast_start;
+	else
+		budget = ktime_add_ns(popup->fast_start,
+				      (u64)(HOTDOG_FULL_COURSE_MICROSTEPS -
+					    popup->slow_steps) *
+				      popup->fast_period_ns);
+
+	return ktime_before(budget, cap) ? budget : cap;
+}
+
+static bool hotdog_popup_run_expired(const struct hotdog_popup *popup)
+{
+	return READ_ONCE(popup->watchdog_fired) ||
+	       !ktime_before(ktime_get(), hotdog_popup_run_deadline(popup));
+}
+
+/* The instant STEP really stopped: the watchdog may have been first. */
+static ktime_t hotdog_popup_run_end(const struct hotdog_popup *popup,
+				    ktime_t now)
+{
+	if (READ_ONCE(popup->watchdog_fired) &&
+	    ktime_before(popup->watchdog_deadline, now))
+		return popup->watchdog_deadline;
+
+	return now;
+}
+
 static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 {
 	int current_up;
 	int current_down;
 	bool progress;
-	u64 remaining_ns;
+	ktime_t deadline;
+	ktime_t now;
 	u64 sleep_us;
 	int ret;
 
@@ -313,9 +531,24 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 
 	popup->endpoint_reached = false;
 	popup->last_steps = 0;
+	popup->last_elapsed_us = 0;
+	popup->run_fast = false;
+	popup->slow_period_ns = HOTDOG_SLOW_PERIOD_NS;
+	popup->fast_period_ns = HOTDOG_FAST_PERIOD_NS;
+	WRITE_ONCE(popup->watchdog_fired, false);
 	hotdog_popup_power_on(popup, upward);
 
-	ret = hotdog_popup_pwm_enable(popup, HOTDOG_SLOW_PERIOD_NS);
+	/*
+	 * STEP keeps pulsing while this thread blocks in a Hall read, so the
+	 * course is counted from wall-clock time and the periods the hardware
+	 * runs, from just before STEP starts (overcounting is the safe side).
+	 * The watchdog enforces the same deadline when this thread cannot.
+	 */
+	popup->run_start = ktime_get();
+	hotdog_popup_watchdog_arm(popup, hotdog_popup_run_deadline(popup));
+	ret = hotdog_popup_pwm_enable(popup, HOTDOG_SLOW_PERIOD_NS,
+				      HOTDOG_STOCK_SLOW_PERIOD_NS,
+				      &popup->slow_period_ns);
 	if (ret)
 		goto out_stop;
 
@@ -326,9 +559,8 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 	 * extended camera.
 	 */
 	sleep_us = DIV_ROUND_UP_ULL((u64)HOTDOG_RAMP_MICROSTEPS *
-					HOTDOG_SLOW_PERIOD_NS, NSEC_PER_USEC);
+					popup->slow_period_ns, NSEC_PER_USEC);
 	usleep_range(sleep_us, sleep_us + 100);
-	popup->last_steps = HOTDOG_RAMP_MICROSTEPS;
 
 	ret = hotdog_popup_read_halls(popup, &current_up, &current_down);
 	if (ret)
@@ -341,10 +573,23 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 			HOTDOG_PROGRESS_MIN_COUNTS ||
 		abs(popup->before_up) - abs(current_up) >=
 			HOTDOG_PROGRESS_MIN_COUNTS;
+	if (hotdog_popup_run_expired(popup))
+		goto out_expired;
 
-	ret = hotdog_popup_pwm_enable(popup, HOTDOG_FAST_PERIOD_NS);
+	/*
+	 * Everything up to here counts as slow microsteps, the switch itself
+	 * as fast ones. The cap deadline stays armed until the tighter
+	 * microstep deadline replaces it.
+	 */
+	popup->fast_start = ktime_get();
+	popup->slow_steps = hotdog_popup_run_steps(popup, popup->fast_start);
+	popup->run_fast = true;
+	ret = hotdog_popup_pwm_enable(popup, HOTDOG_FAST_PERIOD_NS,
+				      HOTDOG_STOCK_FAST_PERIOD_NS,
+				      &popup->fast_period_ns);
 	if (ret)
 		goto out_stop;
+	hotdog_popup_watchdog_arm(popup, hotdog_popup_run_deadline(popup));
 
 	/*
 	 * Both Hall sensors are flat at the mechanical endpoints.  The stock
@@ -355,9 +600,8 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 	if (!progress) {
 		sleep_us = DIV_ROUND_UP_ULL(
 			(u64)HOTDOG_PROGRESS_PROBE_MICROSTEPS *
-			HOTDOG_FAST_PERIOD_NS, NSEC_PER_USEC);
+			popup->fast_period_ns, NSEC_PER_USEC);
 		usleep_range(sleep_us, sleep_us + 100);
-		popup->last_steps += HOTDOG_PROGRESS_PROBE_MICROSTEPS;
 
 		ret = hotdog_popup_read_halls(popup, &current_up, &current_down);
 		if (ret)
@@ -371,23 +615,28 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 				HOTDOG_PROGRESS_MIN_COUNTS ||
 			abs(popup->before_up) - abs(current_up) >=
 				HOTDOG_PROGRESS_MIN_COUNTS;
+		/* A spent budget is not a missed ramp: never retry it. */
+		if (hotdog_popup_run_expired(popup))
+			goto out_expired;
 		if (!progress) {
 			ret = -EPROTO;
 			goto out_stop;
 		}
 	}
 
-	remaining_ns = (u64)(HOTDOG_FULL_COURSE_MICROSTEPS -
-				 popup->last_steps) * HOTDOG_FAST_PERIOD_NS;
-	while (remaining_ns) {
-		u64 interval_ns = min_t(u64, remaining_ns,
-					 (u64)HOTDOG_HALL_POLL_US * NSEC_PER_USEC);
+	for (;;) {
+		u64 interval_ns;
+
+		now = ktime_get();
+		deadline = hotdog_popup_run_deadline(popup);
+		if (READ_ONCE(popup->watchdog_fired) ||
+		    !ktime_before(now, deadline))
+			goto out_expired;
 
+		interval_ns = min_t(u64, ktime_to_ns(ktime_sub(deadline, now)),
+				    (u64)HOTDOG_HALL_POLL_US * NSEC_PER_USEC);
 		sleep_us = DIV_ROUND_UP_ULL(interval_ns, NSEC_PER_USEC);
 		usleep_range(sleep_us, sleep_us + 100);
-		remaining_ns -= interval_ns;
-		popup->last_steps = HOTDOG_FULL_COURSE_MICROSTEPS -
-			DIV_ROUND_UP_ULL(remaining_ns, HOTDOG_FAST_PERIOD_NS);
 
 		ret = hotdog_popup_read_halls(popup, &current_up, &current_down);
 		if (ret)
@@ -406,10 +655,18 @@ static int hotdog_popup_move_profile(struct hotdog_popup *popup, bool upward)
 		}
 	}
 
-	ret = -ERANGE;
+out_expired:
+	/* -ERANGE: microstep budget spent; -ETIMEDOUT: wall-clock cap hit. */
