#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""Prepare Android apps (Waydroid) for this session, as root
(antumbra-waydroid.service, started by the Welcome screen's applier when the
user turned Android apps on).

Waydroid keeps its state in /var/lib/waydroid, which lives in the RAM
overlay, so it is set up again at every boot from the images in the
read-only root filesystem: "waydroid init" finds them preinstalled in
/usr/share/waydroid-extra/images and never contacts Waydroid's update
servers. Before that, waydroid.cfg gets Antumbra's settings:

- overlays off: the root is itself an overlayfs, which cannot be the upper
  layer of another one;
- a generic device identity (the image's own, from product.prop), so that
  Android does not copy the phone's model from the device tree;
- multi-window mode, so Android apps open as ordinary windows;
- the screen density for Phosh's scale (3 on the phone, 2 in the VM);
- in a virtual machine, software rendering (the virtio GPU has no 3D).

Then the container gets a generic kernel command line (the phone's boot
loader puts its serial number on the host's) and the hardware serial
numbers in sysfs are masked, the generated LXC configuration is checked
(Tor-only bridge, start-host hook, every device but cameras, no device
tree, the command line, the masks, the post-stop hook), the container
service is started and /run/antumbra/android-ready tells the user's
session it can start Android.
"""
import configparser
import os
import re
import stat
import subprocess
import sys

WORK = "/var/lib/waydroid"
CFG = os.path.join(WORK, "waydroid.cfg")
LXC_CONFIG = os.path.join(WORK, "lxc", "waydroid", "config")
BASE_PROP = os.path.join(WORK, "waydroid_base.prop")
IMAGES = "/usr/share/waydroid-extra/images"
ANDROID_DIR = "/usr/share/antumbra/android"
LXC_PROFILE = "/etc/apparmor.d/lxc/lxc-waydroid"
READY = "/run/antumbra/android-ready"
# The kernel command line Android sees (bound over its /proc/cmdline by the
# config_3 template): a writable per-boot copy of the image's generic one.
CMDLINE_SRC = os.path.join(ANDROID_DIR, "cmdline")
CMDLINE = "/run/antumbra/android-cmdline"
CMDLINE_ENTRY = f"lxc.mount.entry = {CMDLINE} proc/cmdline none bind,create=file 0 0"
# Hardware serial numbers the container's view of the host's sysfs would
# show every app: the SoC's (soc0), the UFS device's string descriptor and
# the battery's (serial_number), the SCSI disks' unit serial and device
# identification pages and the WWID derived from them, and the "serial"
# of USB, MMC and virtio disks. The start-host hook looks for the same names.
SERIAL_NAMES = ("serial_number", "serial", "vpd_pg80", "vpd_pg83", "wwid")
MASKS_MARK = "# Antumbra (antumbra-waydroid): hardware serial numbers masked"


def log(msg):
    print(msg, flush=True)


def fail(msg):
    print(f"antumbra-waydroid: {msg}", file=sys.stderr, flush=True)
    subprocess.run(["logger", "-t", "antumbra-waydroid", "-p", "daemon.err", "--", msg], check=False)
    sys.exit(1)


def run(cmd):
    log("+ " + " ".join(cmd))
    return subprocess.run(cmd, check=False).returncode


def in_vm():
    return subprocess.run(["systemd-detect-virt", "--vm", "--quiet"], check=False).returncode == 0


def properties():
    props = {}
    with open(os.path.join(ANDROID_DIR, "product.prop"), encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                key, value = line.split("=", 1)
                props[key] = value
    props["persist.waydroid.multi_windows"] = "true"
    vm = in_vm()
    props["ro.sf.lcd_density"] = "320" if vm else "480"
    if vm:
        # Waydroid's vendor image turns "swiftshader" into ANGLE on the
        # SwiftShader Vulkan driver.
        props["ro.hardware.gralloc"] = "default"
        props["ro.hardware.egl"] = "swiftshader"
    return props


def write_config(props):
    cfg = configparser.ConfigParser()
    cfg.read(CFG)
    if "waydroid" not in cfg:
        cfg["waydroid"] = {}
    cfg["waydroid"]["mount_overlays"] = "False"
    cfg["properties"] = props
    os.makedirs(WORK, mode=0o755, exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        cfg.write(f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CFG)


def serial_files(sysfs="/sys"):
    """Every hardware serial number attribute (a regular file named as in
    SERIAL_NAMES) under SYSFS/devices, symbolic links not followed, as
    absolute paths in the host's /sys."""
    found = []
    for dirpath, _dirs, files in os.walk(os.path.join(sysfs, "devices"), onerror=lambda e: None):
        for name in files:
            path = os.path.join(dirpath, name)
            if name in SERIAL_NAMES and stat.S_ISREG(os.lstat(path).st_mode):
                found.append("/sys" + path[len(sysfs):])
    return sorted(found)


def mask_entries(paths):
    """The LXC mount entries that hide PATHS (absolute, in /sys) from the
    container: /dev/null bound read-only over each. LXC parses the entries
    like fstab lines, so a path with white space or a backslash fails."""
    entries = []
    for path in paths:
        if not path.startswith("/sys/") or re.search(r"[\s\\]", path):
            fail(f"cannot mask {path!r} in the container")
        entries.append(f"lxc.mount.entry = /dev/null {path[1:]} none bind,ro 0 0")
    return entries


def add_masks(entries):
    """Append ENTRIES to the generated container configuration, once."""
    with open(LXC_CONFIG, encoding="utf-8") as f:
        text = f.read()
    if MASKS_MARK in text:
        text = text[:text.index(MASKS_MARK)].rstrip("\n") + "\n"
    text += "\n" + MASKS_MARK + "\n" + "".join(e + "\n" for e in entries)
    tmp = LXC_CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, LXC_CONFIG)


def lxc_problems(lxc, serials):
    """What is wrong with the generated container configuration LXC (text),
    given the host's serial number files SERIALS; empty when nothing is."""
    problems = []
    wanted = [r"^lxc\.net\.0\.type = veth$", r"^lxc\.net\.0\.link = waydroid-tor$",
              r"^lxc\.hook\.start-host = /usr/local/lib/antumbra-waydroid-start-host$",
              r"^lxc\.mount\.entry = tmpfs sys/firmware tmpfs ", "^" + re.escape(CMDLINE_ENTRY) + "$"]
    for pattern in wanted:
        if not re.search(pattern, lxc, re.M):
            problems.append(f"the container configuration lacks {pattern}")
    # LXC's device list allows nothing until an "a" rule makes it a deny
    # list: exactly "allow a", then the V4L2 deny.
    devices = re.findall(r"^lxc\.cgroup2\.devices\.\S+ = .*$", lxc, re.M)
    if devices != ["lxc.cgroup2.devices.allow = a", "lxc.cgroup2.devices.deny = c 81:* rwm"]:
        problems.append(f"the container's device rules are not exactly allow a, then deny V4L2: {devices}")
    # Antumbra's post-stop hook ahead of Waydroid's failing /dev/null one.
    post_stop = re.findall(r"^lxc\.hook\.post-stop = (.*)$", lxc, re.M)
    if post_stop[:1] != ["/usr/local/lib/antumbra-waydroid-post-stop"]:
        problems.append(f"the container's post-stop hooks do not start with Antumbra's: {post_stop}")
    for entry in mask_entries(serials):
        if not re.search("^" + re.escape(entry) + "$", lxc, re.M):
            problems.append(f"the container configuration does not mask {entry.split()[3]}")
    cap_keep = re.search(r"^lxc\.cap\.keep = (.*)$", lxc, re.M)
    if not cap_keep or "sys_time" in cap_keep.group(1).split():
        problems.append("the container would keep sys_time")
    return problems


def check_config(props, serials):
    cfg = configparser.ConfigParser()
    cfg.read(CFG)
    if cfg.get("waydroid", "images_path", fallback="") != IMAGES:
        fail(f"waydroid init did not take the preinstalled images ({cfg.get('waydroid', 'images_path', fallback='none')})")
    if cfg.get("waydroid", "mount_overlays", fallback="") != "False":
        fail("waydroid.cfg lost mount_overlays = False")
    for key, value in props.items():
        if cfg.get("properties", key, fallback=None) != value:
            fail(f"waydroid.cfg lost the property {key}")
    try:
        with open(LXC_CONFIG, encoding="utf-8") as f:
            lxc = f.read()
        with open(BASE_PROP, encoding="utf-8") as f:
            base = f.read().split("\n")
    except OSError as e:
        fail(f"waydroid init left no container configuration: {e}")
    for problem in lxc_problems(lxc, serials):
        fail(problem)
    with open(CMDLINE, encoding="utf-8") as f:
        if "androidboot." in f.read():
            fail(f"{CMDLINE} names androidboot values")
    if "waydroid.updater.disabled=true" not in base:
        fail("Waydroid's image updater is not disabled")
    for key in ("ro.product.waydroid.model", "ro.product.waydroid.brand"):
        if f"{key}={props[key]}" not in base:
            fail(f"{key} is not the generic value")


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    if not os.path.exists("/run/antumbra/android-enabled"):
        fail("Android apps are not enabled for this session")
    for img in ("system.img", "vendor.img"):
        if not os.path.isfile(os.path.join(IMAGES, img)):
            fail(f"{IMAGES}/{img} is missing")
    # Waydroid's container profile (complain mode, as Debian ships it) sits
    # in a subdirectory that apparmor.service does not load; load it so the
    # container runs under it and its log shows what an enforcing profile
    # would have to allow. Without it Waydroid runs the container unconfined.
    if os.path.exists(LXC_PROFILE) and run(["aa-enabled", "--quiet"]) == 0:
        if run(["apparmor_parser", "--replace", "--write-cache", LXC_PROFILE]) != 0:
            log("warning: the lxc-waydroid AppArmor profile did not load; the container runs unconfined")
    props = properties()
    write_config(props)
    if run(["waydroid", "init"]) != 0:
        fail("waydroid init failed")
    # "upgrade -o" (offline) regenerates the LXC configuration and the base
    # properties from the templates and waydroid.cfg, as Debian's postinst does.
    if run(["waydroid", "upgrade", "-o"]) != 0:
        fail("waydroid upgrade -o failed")
    # The container's kernel command line and the serial number masks:
    # after "upgrade", which regenerates the configuration from the templates.
    with open(CMDLINE_SRC, encoding="utf-8") as f:
        cmdline = f.read()
    with open(CMDLINE + ".tmp", "w", encoding="utf-8") as f:
        f.write(cmdline)
    os.chmod(CMDLINE + ".tmp", 0o644)
    os.replace(CMDLINE + ".tmp", CMDLINE)
    serials = serial_files()
    add_masks(mask_entries(serials))
    log(f"{len(serials)} hardware serial number files masked in the container")
    check_config(props, serials)
    if run(["systemctl", "start", "waydroid-container.service"]) != 0:
        fail("the Waydroid container service did not start")
    with open(READY, "w", encoding="utf-8") as f:
        f.write("1\n")
    os.chmod(READY, 0o644)
    log("Android apps ready for the session")


if __name__ == "__main__":
    main()
