[Unit]
Description=Set the default state of wireless devices (Wi-Fi only)
Documentation=https://tails.net/contribute/design/
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/antumbra-set-wireless-devices-state
CapabilityBoundingSet=~CAP_SYS_ADMIN
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
