#!/bin/sh
# Ported from Tails' tails-create-netns (iptables replaced by nftables).
#
# Creates one network namespace per confined application, each wired to the
# host with a veth pair in a /30 of 10.200.1.0/24. From inside a namespace the
# application reaches Tor's SocksPort and/or the control-port filter through
# DNAT of 127.0.0.1:<port> to the host address; the host firewall
# (/etc/nftables.conf) accepts exactly those flows. The clearnet namespace is
# the only one with Internet access (NAT), for the Unsafe Browser.
guestVeth="veth0"
set -ue

increment_ip_address() {
    echo "$1" | python3 -c 'base, host = input().rsplit(".", 1); print("%s.%s" % (base, int(host)+1))'
}
decrement_ip_address() {
    echo "$1" | python3 -c 'base, host = input().rsplit(".", 1); print("%s.%s" % (base, int(host)-1))'
}
get_netns_guest_address() {
    ip netns exec "$1" ip -4 a show dev "$guestVeth" | grep -Po 'inet \K[\d.]+'
}
get_netns_host_address() {
    decrement_ip_address "$(get_netns_guest_address "$1")"
}
ns_nft() { # ns_nft NS 'rule'
    ns="$1"; shift
    ip netns exec "$ns" nft "$@"
}

expose() { # expose NS GUESTPORT HOSTPORT
    [ $# -eq 3 ] || { echo 'Wrong expose usage' >&2; exit 2; }
    ns="$1"; guestPort="$2"; hostPort="$3"
    hostAddress="$(get_netns_host_address "$ns")"
    ns_nft "$ns" add rule ip antumbra output_nat oifname "lo" ip daddr 127.0.0.1 tcp dport "$guestPort" dnat to "${hostAddress}:${hostPort}"
}

expose_all() { # the clearnet namespace: default route + NAT through the host
    ns="$1"
    hostAddress="$(get_netns_host_address "$ns")"
    guestAddress="$(get_netns_guest_address "$ns")"
    hostVeth="veth-${ns}"
    netmask=30
    ip netns exec "${ns}" ip route add default via "${hostAddress}"
    antumbra-add-session-firewall-rule --apply "add rule inet antumbra-session forward iifname \"${hostVeth}\" accept"
    antumbra-add-session-firewall-rule --apply "add rule inet antumbra-session forward oifname \"${hostVeth}\" accept"
    antumbra-add-session-firewall-rule --apply "add rule ip antumbra-session-nat postrouting ip saddr ${guestAddress}/${netmask} masquerade"
    sysctl -q net.ipv4.ip_forward=1
    sysctl -q "net.ipv4.conf.${hostVeth}.forwarding=1"
}

forbid_incoming() {
    ns="$1"
    ns_nft "$ns" add chain ip antumbra input '{ type filter hook input priority filter; policy drop; }'
    ns_nft "$ns" add rule ip antumbra input ct state related,established accept
    ns_nft "$ns" add rule ip antumbra input iifname "lo" accept
}

delete_netns() {
    basename="$1"
    ip link del "veth-${basename}" 2>/dev/null || true
    ip netns del "${basename}" 2>/dev/null || true
}

create_netns() { # create_netns NAME FIRST_ADDRESS (implies /30)
    [ $# -eq 2 ] || { echo "Wrong usage for create_netns" >&2; exit 2; }
    basename="$1"; hostAddress="$2"; netmask=30
    nsName="${basename}"; hostVeth="veth-${basename}"
    if [ "${#hostVeth}" -ge 16 ]; then
        echo "netns name too long '${hostVeth}'; it would have a veth name >= 16" >&2
        exit 2
    fi
    guestAddress="$(increment_ip_address "$hostAddress")"
    ip netns add "$nsName"
    ip netns exec "$nsName" ip link set dev lo up
    ip link add "$hostVeth" type veth peer name "$guestVeth"
    ip link set "$guestVeth" netns "$nsName"
    ip addr add "${hostAddress}/$netmask" dev "$hostVeth"
    ip link set dev "$hostVeth" up
    ip netns exec "$nsName" ip addr add "${guestAddress}/$netmask" dev "$guestVeth"
    ip netns exec "$nsName" ip link set dev "$guestVeth" up

    # Firewall inside the namespace: no IP spoofing, no forwarding, NAT out.
    ns_nft "$nsName" add table ip antumbra
    ns_nft "$nsName" add chain ip antumbra output '{ type filter hook output priority filter; policy accept; }'
    ns_nft "$nsName" add rule ip antumbra output oifname "$guestVeth" ip saddr != "$guestAddress" reject
    ns_nft "$nsName" add chain ip antumbra output_nat '{ type nat hook output priority dstnat; policy accept; }'
    ns_nft "$nsName" add chain ip antumbra postrouting '{ type nat hook postrouting priority srcnat; policy accept; }'
    ns_nft "$nsName" add rule ip antumbra postrouting masquerade
    ip netns exec "$nsName" sysctl -q net.ipv4.ip_forward=0
    ip netns exec "$nsName" sysctl -q net.ipv4.conf.all.forwarding=0
    ip netns exec "$nsName" sysctl -q net.ipv4.conf.lo.forwarding=0
    ip netns exec "$nsName" sysctl -q net.ipv4.conf.all.route_localnet=1
    sysctl -q "net.ipv4.conf.${hostVeth}.forwarding=0"
}

[ "$#" -eq 1 ] || { echo "Usage: $0 start|stop" >&2; exit 2; }

if [ "$1" = stop ]; then
    for ns in tbb onioncircs tca onionshare clearnet; do delete_netns "$ns"; done
    exit 0
fi

if [ "$1" = start ]; then
    modprobe veth
    netBase='10.200.1'
    create_netns tbb "${netBase}.1"
    create_netns onioncircs "${netBase}.5"
    create_netns tca "${netBase}.9"
    create_netns onionshare "${netBase}.13"
    create_netns clearnet "${netBase}.17"
    expose tbb 9050 9050
    expose tbb 951 951
    expose onioncircs 951 951
    expose tca 951 951
    expose onionshare 9050 9050
    expose onionshare 951 951
    expose_all clearnet
    # Applications in the clearnet namespace are the least trusted: they
    # may not receive any external connection either.
    forbid_incoming clearnet
    exit 0
fi
echo "Usage: $0 start|stop" >&2; exit 2
