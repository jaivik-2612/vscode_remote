#!/bin/sh
# Antumbra initramfs hook: the recorded live-partition UUID and the few tools
# and modules the loop/overlay/verity path needs (most are built into the kernel).
PREREQ="udev"
prereqs() { echo "${PREREQ}"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
mkdir -p "${DESTDIR}/etc/antumbra"
cp /etc/antumbra/live-fs-uuid "${DESTDIR}/etc/antumbra/live-fs-uuid"
copy_exec /sbin/blkid /sbin
copy_exec /sbin/losetup /sbin
copy_exec /usr/bin/udevadm /usr/bin
manual_add_modules loop overlay squashfs ext4 dm-verity dm-mod
exit 0
