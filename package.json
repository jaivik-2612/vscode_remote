{
  "name": "fairshare",
  "version": "1.0.0",
  "description": "FairShare — an educational fair-price calculator for stock options",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "optprice": "bin/optprice.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./black-scholes": "./src/blackScholes.js",
    "./binomial": "./src/binomial.js",
    "./implied-vol": "./src/impliedVol.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node server.js",
    "price": "node bin/optprice.js",
    "refresh-data": "node tools/refresh-data.mjs"
  },
  "keywords": [
    "options",
    "black-scholes",
    "binomial",
    "greeks",
    "implied-volatility",
    "finance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
